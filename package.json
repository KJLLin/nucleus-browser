{
  "name": "nucleus-browser",
  "productName": "Nucleus",
  "version": "0.1.1-rc1",
  "description": "Nucleus — 基于 Cordis 的「一切皆插件」浏览器：槽位化界面、类型化 RPC、配置层与浏览器扩展支持。",
  "main": "src/main/main.js",
  "author": "KJLLin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:linux": "electron . --no-sandbox",
    "pack:win": "node build/pack-win.js",
    "vendor": "esbuild node_modules/cordis/lib/index.js --bundle --format=esm --target=es2020 --platform=neutral --outfile=src/renderer/vendor/cordis.mjs"
  },
  "devDependencies": {
    "@electron/packager": "18.1.3",
    "cordis": "^4.0.0-rc.12",
    "electron": "22.3.27",
    "esbuild": "^0.28.2",
    "resedit": "2.0.3"
  }
}
