{
  "manifest_version": 2,
  "name": "Hello Nucleus",
  "version": "1.0",
  "description": "验证用扩展：给页面加一个角标，记录最后访问的网址，popup 里显示并支持与后台页通信。",
  "permissions": ["storage", "tabs", "contextMenus"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Hello Nucleus"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  }
}
