{
  "id": "feature.tabsleep",
  "name": "标签休眠",
  "version": "1.0.0",
  "author": "Nucleus",
  "description": "把长期不看的后台标签的渲染进程释放掉，只保留标题与地址；切回去时按原地址重建。",
  "ui": "ui.js",
  "permissions": ["tabs", "commands", "settings", "storage"],
  "contributes": {
    "settings": [
      {
        "section": "标签休眠",
        "items": [
          { "key": "enabled", "label": "自动休眠后台标签", "type": "boolean", "default": true },
          {
            "key": "idleMinutes",
            "label": "空闲多久后休眠",
            "type": "select",
            "default": 15,
            "options": [
              { "value": 5, "label": "5 分钟" },
              { "value": 15, "label": "15 分钟" },
              { "value": 30, "label": "30 分钟" },
              { "value": 60, "label": "1 小时" }
            ]
          },
          {
            "key": "keepRecent",
            "label": "最近使用的标签保护数量",
            "type": "select",
            "default": 2,
            "options": [
              { "value": 0, "label": "不保护" },
              { "value": 2, "label": "最近 2 个" },
              { "value": 4, "label": "最近 4 个" },
              { "value": 6, "label": "最近 6 个" }
            ]
          }
        ]
      }
    ],
    "commands": [
      { "id": "tabsleep.now", "title": "立即休眠空闲标签", "icon": "moon" },
      { "id": "tabsleep.wake", "title": "唤醒全部休眠标签", "icon": "sun" },
      { "id": "tabsleep.toggle", "title": "开关自动休眠", "icon": "zap" }
    ]
  }
}
