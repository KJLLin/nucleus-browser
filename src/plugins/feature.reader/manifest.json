{
  "id": "feature.reader",
  "name": "阅读模式",
  "version": "1.0.0",
  "author": "Nucleus",
  "description": "提取网页正文，去掉导航、广告和侧栏，用统一的排版重新呈现。纯前端实现，不上传任何内容。",
